# ==============================================================================
# Homelab OS (HL-OS) — Unified Environment Configuration Template
# Copy this template to .env and configure before starting: cp .env.example .env
# ==============================================================================

# ── General Server Settings ──────────────────────────────────────────────────
TZ=UTC
STORAGE_PATH=/mnt/storage
NET_IFACE=eth0

# ── Admin Dashboard (FastAPI) ────────────────────────────────────────────────
DASHBOARD_PORT=5001
DASHBOARD_SECRET=generate_with_openssl_rand_hex_32
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=replace_with_secure_dashboard_password
FORCE_HTTPS=false
WAKE_PROXY_ENABLED=true

# ── Pi-hole DNS ──────────────────────────────────────────────────────────────
PIHOLE_PASSWORD=replace_with_secure_pihole_password
PIHOLE_WEB_PORT=8080

# ── Samba File Server (SMB over VPN / LAN) ───────────────────────────────────
SAMBA_SHARE_PATH=/mnt/storage
SAMBA_USER=homelab
SAMBA_PASSWORD=replace_with_secure_samba_password

# ── MariaDB / Nextcloud Database ─────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=replace_with_secure_root_password
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=replace_with_secure_db_password

# ── Redis Cache ──────────────────────────────────────────────────────────────
REDIS_PASSWORD=replace_with_secure_redis_password

# ── Nextcloud ────────────────────────────────────────────────────────────────
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=replace_with_secure_admin_password
NEXTCLOUD_PORT=8081
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1 cloud.homelab.local

# ── Navidrome & Maloja Music Stack ───────────────────────────────────────────
NAVIDROME_PORT=4533
MALOJA_PORT=42010
MALOJA_DATA_PATH=./maloja/data
MALOJA_ADMIN_PASSWORD=replace_with_secure_maloja_password
MALOJA_API_KEY=generate_with_openssl_rand_hex_32
MALOJA_API_SECRET=bypass

# ── Backup Configuration ─────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=7

# ── Cloudflare Zero Trust Defense-in-Depth (Optional) ────────────────────────
CLOUDFLARE_ZERO_TRUST_ENABLED=false
ALLOWED_ZERO_TRUST_EMAILS="admin@example.com,user@example.com"
ZERO_TRUST_BYPASS_LOCAL=true
